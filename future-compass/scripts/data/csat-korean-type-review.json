    },
    "sl": {
      "slug": "speech-listening",
      "unit": "화법",
      "label": "청중 반응·듣기",
      "method": "청중이 보인 질문·평가·이해의 근거를 찾아, 실제 발표 내용과 일치하는지 확인합니다."
    },
    "xu": {
      "slug": "integrated-context",
