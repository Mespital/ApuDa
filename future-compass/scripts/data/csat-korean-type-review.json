{
  "reviewedAt": "2026-11-21",
  "reviewMethod": "홀수형 원문 발문·지문 묶음·선택지의 대표 평가 내용을 대조한 문항별 분류. 동일 번호의 유형을 연도 간 복사하지 않음.",
  "typeDefinitions": {
    "ri": {
      "slug": "reading-info",
      "unit": "독서",
      "label": "세부 정보·핵심 내용 확인",
      "method": "질문의 대상과 범위를 먼저 정하고, 지문의 정의·조건·주장에 일치하는 근거를 찾습니다."
    },
    "rr": {
      "slug": "reading-reasoning",
      "unit": "독서",
      "label": "추론·개념 관계 분석",
      "method": "전제와 결론을 나누고 인과·대립·포함 관계를 표시합니다. 지문에 없는 전제를 추가하지 않습니다."
    },
    "ra": {
      "slug": "reading-application",
      "unit": "독서",
      "label": "보기·자료·사례 적용",
      "method": "지문의 원리를 보기의 대상·조건과 대응시킨 뒤, 달라진 조건이 결론에 미치는 영향을 확인합니다."
    },
    "rs": {
      "slug": "reading-structure",
      "unit": "독서",
      "label": "글 전개·비교 방식",
      "method": "각 문단의 역할과 글의 설명 순서를 요약하고, 두 글에서 공통되거나 달라지는 전개 방식을 구분합니다."
    },
    "rv": {
      "slug": "reading-vocabulary",
      "unit": "독서",
      "label": "어휘·문맥 의미",
      "method": "사전적 뜻만 보지 말고 해당 문장의 주어·목적어와 문맥에 맞는 의미·용례를 대조합니다."
    },
    "rm": {
      "slug": "reading-process",
      "unit": "독서",
      "label": "독서 활동·과정 점검",
      "method": "읽기 목적·전략과 실제 독서 행동을 연결하고, 질문·기록·점검 과정이 지문의 설명에 맞는지 확인합니다."
    },
    "li": {
      "slug": "literature-content",
      "unit": "문학",
      "label": "작품 내용·정서 이해",
      "method": "인물·화자·대상·사건의 관계를 정리하고, 정서와 태도를 작품 속 말과 행동으로 확인합니다."
    },
    "lm": {
      "slug": "literature-meaning",
      "unit": "문학",
      "label": "표시된 구절·장면의 의미",
      "method": "표시된 구절의 앞뒤 맥락과 발화 주체를 확인하고, 장면·소재가 드러내는 의미를 해석합니다."
    },
    "le": {
      "slug": "literature-expression",
      "unit": "문학",
      "label": "서술·표현·구성 방식",
      "method": "서술자·시점·이미지·반복·대조 등 실제 표현을 찾고, 그 표현의 효과를 작품 맥락에서 확인합니다."
    },
    "lc": {
      "slug": "literature-comparison",
      "unit": "문학",
      "label": "작품·대목 비교",
      "method": "두 작품이나 대목의 주체·상황·태도를 각각 확인한 뒤, 공통점과 차이점을 같은 기준으로 비교합니다."
    },
    "la": {
      "slug": "literature-appreciation",
      "unit": "문학",
      "label": "보기와 감상 관점 적용",
      "method": "보기나 설명에서 제시한 감상 관점을 먼저 정리하고, 작품의 구체적인 장면·시구와 연결합니다."
    },
    "ss": {
      "slug": "speech-strategy",
      "unit": "화법",
      "label": "발표·말하기 전략",
      "method": "목적·청중·상황을 확인하고, 질문·예시·강조 등 말하기 전략의 기능을 실제 발화와 대조합니다."
    },
    "sd": {
      "slug": "speech-materials",
      "unit": "화법",
      "label": "자료·시각 정보 활용",
