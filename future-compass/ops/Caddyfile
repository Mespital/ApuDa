:8080 {
  root * /srv/compass/current
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Cache-Control "no-store"
  }
  handle /health {
    reverse_proxy auth:8081
  }
  handle /api/* {
    reverse_proxy auth:8081
  }
  @public path /login.html /auth.js /auth.css /sw.js /shiro-letter.jpg /app-icon.svg /app-icon-192.png /app-icon-512.png /share-cover-v2.jpg
  handle @public {
    file_server
  }
  handle {
    forward_auth auth:8081 {
      uri /verify
    }
    file_server
  }
}
