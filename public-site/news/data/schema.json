{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apuda.app/news/data/schema.json",
  "title": "ApuDa Daily News Briefing",
  "type": "object",
  "required": ["version","report_date","collection_window","sources","briefing","top_news","trends","outlet_status","insight"],
  "properties": {
    "version": {"type":"string"},
    "report_date": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "collection_window": {
      "type":"object",
      "required":["start","end","timezone"],
      "properties":{
        "start":{"type":"string"},
        "end":{"type":"string"},
        "timezone":{"const":"Asia/Seoul"}
      }
    },
    "sources":{"type":"array","items":{"type":"string"}},
    "briefing":{"type":"string"},
    "top_news":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["rank","canonical_issue","title","category","publishers","summary","importance","source_urls"],
        "properties":{
          "rank":{"type":"integer","minimum":1},
          "canonical_issue":{"type":"string"},
          "title":{"type":"string"},
          "category":{"type":"array","items":{"type":"string"}},
          "publishers":{"type":"array","items":{"type":"string"}},
          "published_at":{"type":["string","null"]},
          "published_at_verified":{"type":"boolean"},
          "summary":{"type":"array","items":{"type":"string"}},
          "importance":{"type":"string"},
          "source_urls":{"type":"array","items":{"type":"string"}},
          "oncology":{
            "type":["object","null"],
            "properties":{
              "is_oncology":{"type":"boolean"},
              "cancer_types":{"type":"array","items":{"type":"string"}},
              "drug_generic":{"type":"array","items":{"type":"string"}},
              "drug_brand":{"type":"array","items":{"type":"string"}},
              "targets":{"type":"array","items":{"type":"string"}},
              "mechanism":{"type":"array","items":{"type":"string"}},
              "biomarkers":{"type":"array","items":{"type":"string"}},
              "trial_name":{"type":["string","null"]},
              "phase":{"type":["string","null"]},
              "line_of_therapy":{"type":["string","null"]},
              "endpoints":{
                "type":"object",
                "properties":{
                  "orr":{"type":["string","null"]},
                  "pfs":{"type":["string","null"]},
                  "os":{"type":["string","null"]},
                  "hr":{"type":["string","null"]},
                  "grade3plus_ae":{"type":["string","null"]}
                }
              },
              "approval_status":{"type":["string","null"]},
              "reimbursement_status":{"type":["string","null"]},
              "patient_summary":{"type":["string","null"]},
              "industry_summary":{"type":["string","null"]}
            }
          }
        }
      }
    },
    "trends":{"type":"array","items":{"type":"object","required":["title","change","implication"],"properties":{"title":{"type":"string"},"change":{"type":"string"},"implication":{"type":"string"}}}},
    "outlet_status":{"type":"array","items":{"type":"object","required":["publisher","items"],"properties":{"publisher":{"type":"string"},"items":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"published_at":{"type":["string","null"]},"verified":{"type":"boolean"}}}}}}},
    "insight":{"type":"string"},
    "infographic":{"type":"object","properties":{"image_path":{"type":["string","null"]},"generated_at":{"type":["string","null"]},"template_version":{"type":"string"}}}
  }
}